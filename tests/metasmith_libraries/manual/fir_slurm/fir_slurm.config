// Nextflow SLURM executor config for fir (Alliance Canada / DRAC).
//
// Conventions:
//   - cpu_small  -> CPU partition, no GPU
//   - cpu_large  -> CPU partition, fatter resource ask
//   - gpu_small  -> 1g.10gb MIG slice (10 GB VRAM): ESM-C 300M, Ankh-base
//   - gpu_med    -> 3g.40gb MIG slice (40 GB VRAM): ESMFold, SaProt 650M
//   - gpu_full   -> full H100 80GB (one card; multi-card via clusterOptions override)
//
// Run from the login node, NOT inside an salloc; Nextflow submits each
// process as its own SLURM job. Validated 2026-05-19: both a cpu_small
// and a gpu_small process route to the correct partitions and Nextflow
// observes COMPLETED state via sacct.

params {
    cpu_account = 'def-shallam'        // CPU-only account
    gpu_account = 'def-shallam_gpu'    // GPU account
}

executor {
    name = 'slurm'
    queueSize = 32
    submitRateLimit = '1/3sec'
    pollInterval = '15sec'
}

process {
    cache = 'lenient'
    errorStrategy = 'retry'
    maxRetries = 1

    cpus = 2
    memory = '8 GB'
    time = '1h'
    clusterOptions = "--nodes=1 --ntasks=1 --account=${params.cpu_account}"

    withLabel: cpu_small {
        cpus = 4
        memory = '8 GB'
        time = '30m'
        clusterOptions = "--nodes=1 --ntasks=1 --account=${params.cpu_account}"
    }

    withLabel: cpu_large {
        cpus = 24
        memory = '64 GB'
        time = '6h'
        clusterOptions = "--nodes=1 --ntasks=1 --account=${params.cpu_account}"
    }

    withLabel: gpu_small {
        cpus = 4
        memory = '16 GB'
        time = '30m'
        clusterOptions = "--nodes=1 --ntasks=1 --account=${params.gpu_account} --gpus=nvidia_h100_80gb_hbm3_1g.10gb:1"
    }

    withLabel: gpu_med {
        cpus = 8
        memory = '32 GB'
        time = '1h'
        clusterOptions = "--nodes=1 --ntasks=1 --account=${params.gpu_account} --gpus=nvidia_h100_80gb_hbm3_3g.40gb:1"
    }

    withLabel: gpu_full {
        cpus = 8
        memory = '64 GB'
        time = '2h'
        clusterOptions = "--nodes=1 --ntasks=1 --account=${params.gpu_account} --gpus=h100:1"
    }
}

report.overwrite = true
timeline.overwrite = true
