# Base container only. bioconda's metapop 1.0.2 is the older R pipeline; the Python MetaPop 0.0.60 that
# Pratama ran, with bowtie2, comes from bench::metapop_env_image bound at /opt/metapop
# (drivers/refs/build_metapop_env.sh).
container: docker://quay.io/biocontainers/metapop:1.0.2--hdfd78af_1
conda: metapop
