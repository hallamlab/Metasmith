# SCIP no time limit and an exact-optimum target, and SCIP stalls on fragmentary bins. On fir,
# 2026-09-14, 1.6.6 finished 14 of 14 stalled E5 bins in 21.6 min or less, with the standard
# helper script unchanged.
container: docker://quay.io/biocontainers/carveme:1.6.6--pyhdfd78af_1
conda: carveme
