/*
 * E1ctl long arm: depth as E1's scored long MetaBAT2 took it (b19_long_rerun.sbatch),
 * identity 80 on the metabat2 2.17 image, and SemiBin2 in long-read mode as E1 ran it.
 *
 * CAUTION an assembly passed through --assembly_input loses what the read meta carried, and
 * nf-core/mag 5.5.0 branches on two of those fields:
 *   - assembly_input accepts only `Flye`, and a long-read assembly reaches the long-read depth
 *     process by the case-sensitive `meta.assembler in ['FLYE', 'METAMDBG']`
 *     (subworkflows/local/binning/main.nf:36). Every assembly in this arm therefore takes the
 *     SHORTREAD depth process, so both are configured here.
 *   - SemiBin2's read type is `meta.lr_platform ? long_reads : short_reads`
 *     (conf/modules.config:1036), and the assembly meta has no lr_platform. The block below is
 *     nf-core's own with the read type fixed.
 */
process {
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_SHORTREAD {
        container = 'quay.io/biocontainers/metabat2:2.17--hd498684_0'
        ext.args  = '--percentIdentity 80'
    }
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_LONGREAD {
        container = 'quay.io/biocontainers/metabat2:2.17--hd498684_0'
        ext.args  = '--percentIdentity 80'
    }
    withName: SEMIBIN_SINGLEEASYBIN {
        ext.args2 = {
            [
                params.semibin_rng_seed == 0 ? "" : "--random-seed ${params.semibin_rng_seed}",
                "--min-len ${params.min_contig_size}",
                "--compression gz",
                "--engine cpu",
                "--sequencing-type long_reads",
                meta.sample_count == 1 ? "--environment ${params.semibin_environment}" : "",
            ].join(' ').trim()
        }
    }
}
