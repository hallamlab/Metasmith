# DeepLocPro 1.0 from its public GitHub repository.
# Build: apptainer build deeplocpro.sif docker/deeplocpro/apptainer.def (from the repository root)
# python:3.10-slim-bookworm as of 2026-11-21.
Bootstrap: docker
From: python@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370

%files
    docker/deeplocpro/install.sh /opt/msm-build/install.sh

%environment
    export TORCH_HOME=/opt/torch

%post
    export TORCH_HOME=/opt/torch
    sh /opt/msm-build/install.sh
    rm -rf /opt/msm-build
