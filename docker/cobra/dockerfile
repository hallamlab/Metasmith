# The cobra runtime: reading, gapfilling and solving genome-scale models.
#
# This exists because `resources/env/cobra.env` was, of 87 environment files, the only
# one with no `container:` line at all -- so the four modelling transforms could not run
# under the DOCKER or APPTAINER runtimes at any point in curation rounds 3 and 4.
#
# NOT MERGEABLE INTO python_for_data_science. See env.yml: numpy<2 against numpy>=2.
#
# Base is digest-pinned, not :latest, for the reason docker/ecspr_bake/dockerfile gives:
# an image whose base moves under it is not a reproducible image.
FROM condaforge/miniforge3:25.3.0-3 AS build-env
ARG VERIFY

COPY env.yml /opt/env.yml
RUN --mount=type=cache,target=/opt/conda/pkgs \
    --mount=type=cache,target=/root/.cache/pip \
    mamba env create -n cobra -f /opt/env.yml
ENV PATH=/opt/conda/envs/cobra/bin:$PATH

FROM build-env AS final
# Fail the BUILD, not a queued job hours later, if a pin regressed.
RUN python -c "${VERIFY}"

ADD ./load/tini /tini
RUN chmod +x /tini
ENTRYPOINT ["/tini", "-s", "-g", "--"]
