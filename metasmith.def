Bootstrap: docker
From: condaforge/miniforge3

%files
    ./lib/tini /tini
    ./envs/base.yml /opt/base.yml
    ./dist/metasmith-0.17.1+c19bcd5.tar.gz /opt/metasmith.tar.gz
    ./lib/globusconnectpersonal-latest /opt/globusconnectpersonal-latest
    ./main/relay_agent/target/x86_64-unknown-linux-musl/release/msm_relay /app/msm_relay.x86_64-linux
    ./main/relay_agent/target/aarch64-unknown-linux-musl/release/msm_relay /app/msm_relay.arm64-linux
    ./main/relay_agent/target/x86_64-apple-darwin/release/msm_relay /app/msm_relay.x86_64-darwin
    ./main/relay_agent/target/aarch64-apple-darwin/release/msm_relay /app/msm_relay.arm64-darwin

%post
    export DEBIAN_FRONTEND=noninteractive
    chmod +x /tini

    apt-get update
    apt-get install -y --no-install-recommends openssh-client tmux
    rm -rf /var/lib/apt/lists/*

    # Mirror Dockerfile: create the env at the path the bin/* shebangs expect.
    # The shebangs in src/metasmith/bin/{sbatch,scancel,squeue} are
    # `#!/opt/conda/envs/metasmith_env/bin/python` so the env name is load-bearing.
    mamba env create -n metasmith_env -f /opt/base.yml

    /opt/conda/envs/metasmith_env/bin/pip install /opt/metasmith.tar.gz

    # The Dockerfile symlinks the package's bin/* into /app so they end up on PATH.
    ln -s /opt/conda/envs/metasmith_env/lib/python3.12/site-packages/metasmith/bin/* /app/

%environment
    export PATH=/opt/conda/envs/metasmith_env/bin:/app:/opt/globusconnectpersonal-latest:$PATH

%runscript
    exec /tini -s -g -- "$@"
