# python:3.10-slim-bookworm as of 2026-11-21.
Bootstrap: docker
From: python@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370

%files
    {{ recipe }}/install.sh /opt/msm-build/install.sh
    {{ package }} /opt/msm-build/package

%post
    sh /opt/msm-build/install.sh /opt/msm-build/package
    rm -rf /opt/msm-build
