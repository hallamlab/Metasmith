# 1.0.3, verified 2026-09-09, digest
# sha256:e71b0ab781af9a1093fcf160beee587cc96aa50ff7c1a2b078166201fa390725.
# `checkv` is on PATH (it has no --version; the parser is reached and rejects the
# flag). Also carries diamond 2.1.8 and HMMER 3.4, which end_to_end shells out to.
#
# Two deliberate choices ride on this file.
#
# It is held at 1.0.3 while 1.1.1 exists. The adapters select quality_summary.tsv
# by column NAME and that 14-column list was checked against 1.0.3; re-verify it
# before bumping. Antonio ran 1.0.1, so this is already one ahead of the paper.
#
# It also provides prodigal-gv, which is why transforms/viromics/prodigal_gv.py
# takes this env rather than its own. `prodigal-gv -v` here answers
# `Prodigal V2.11.0-gv: March, 2023` -- the same upstream build as the standalone
# biocontainer, one fewer image to pull, cache and stage.
container: docker://quay.io/biocontainers/checkv:1.0.3--pyhdfd78af_0
conda: checkv
