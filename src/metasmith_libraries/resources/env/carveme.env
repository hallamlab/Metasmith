# CarveMe 1.6.1, verified 2026-09-11, digest
# sha256:422ffcdb5339416ae0595217b1ba2ddd5dbf8387c7224c03db807d02e0a8aba9.
#
# Ships reframed 1.5.1 and PySCIPOpt's `scip` binary on PATH. `gapfill` has no
# `--solver` flag and falls through to `carveme.config`'s `solver = cplex`, which
# is not installed and reframed never imports unless asked -- confirmed inside this
# image: `reframed.solvers.solvers == {"scip": SCIPSolver}` and `default_solver is
# None`. `carveme_gapfill.py` calls `reframed.solvers.set_default_solver("scip")`
# before touching `carveme.cli.gapfill`, and running it end-to-end against a real
# draft (68-reaction GPR fixture, `carveme_biomass.py` + `carveme_transport.py`
# ahead of it) is what this pin was verified against, not a bare import.
#
# `data/generated/universe_bacteria.xml.gz`'s `Growth` reaction (57 metabolites)
# and `data/generated/universe_gramneg.xml.gz`'s (64) are read directly out of the
# image by `carveme_biomass.py`; `data/input/media_db.tsv` is read once, offline,
# to build `research/metasmith_libraries/carveme_m9_medium.tsv` in this repo's
# own namespace -- neither is a runtime requirement of any transform.
container: docker://quay.io/biocontainers/carveme:1.6.1--pyhdfd78af_0
conda: carveme
