# metawrap-mg 1.3.0, verified 2026-09-10, digest
# sha256:41c69171237bb16e83cfc137f36457c22e19d867336d8723ab1cdc8aa2721c84.
# `metawrap --version` answers `metaWRAP v=1.3.0`, and metabat2, run_MaxBin.pl,
# concoct, bwa, salmon and checkm are all on PATH beside it -- the binning module
# drives them itself, so this one image covers the whole transform.
#
# It also carries CheckM **1**'s reference: 1.4 GB at /usr/local/etc/checkm, which
# is already what the package's own DATA_CONFIG names. So bin_refinement needs no
# reference input. That was checked by running `checkm taxon_list` in the image as
# a non-root user, which is how the transform runs it.
container: docker://quay.io/biocontainers/metawrap-mg:1.3.0--hdfd78af_1
conda: metawrap-mg
