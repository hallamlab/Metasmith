# 1.3.3, verified 2026-09-09, digest
# sha256:3354c972ccbc467e1f64e01ae91a427db137de385219f5af6af2b93f1c222242.
# `iphop` is on PATH and prints its predict / download / add_to_db tasks.
#
# Held at 1.3.3 on purpose, and the reason is a database, not a preference.
# iPHoP_db_Aug23_rw is built on GTDB r214 and requires >= 1.3.3; the newer
# iPHoP_db_Jun25_rw is GTDB r226 and requires >= 1.4.1. research/viromics/
# pipeline_steps.yml runs GTDB-Tk at r214, so 1.3.3 + Aug23_rw is the pairing
# that keeps host calls and MAG taxonomy on one release. Bumping the image
# silently changes the database and therefore the answers.
#
# Budget for a slow start: `iphop --help` took over 90 s in a warm container on a
# workstation, before any work. That is import cost and it belongs in Resources().
container: docker://quay.io/biocontainers/iphop:1.3.3--pyhdfd78af_0
conda: iphop
