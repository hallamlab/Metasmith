# 1.4.2, digest sha256:ce0bb3babefcfb44a3e37c0ca2aaf5d183ff5602a5a2f1b2203fd8f746b774ab.
# `iphop` is on PATH and prints its predict / download / add_to_db tasks.
#
# The version is set by the host database, not by preference. iPHoP_db_Jun25_rw is
# built on GTDB r226 and needs >= 1.4.1. No r232 host database exists, so add_to_db
# grafts this survey's r232 de novo trees into an r226 database. Aug23_rw (r214)
# needs 1.3.3, and moving between the two changes the answers.
#
# Budget for a slow start: `iphop --help` took over 90 s in a warm container on a
# workstation, before any work. That is import cost and it belongs in Resources().
container: docker://quay.io/biocontainers/iphop:1.4.2--pyhdfd78af_0
conda: iphop
