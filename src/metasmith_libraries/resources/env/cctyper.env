# 1.8.0 build _2, verified 2026-09-09, digest
# sha256:1e4329271c33f3a3734441729ea5b5be229dcc8a96b16dff73d23f6be30fcc74.
# `cctyper` is on PATH and prints usage; blastn, makeblastdb, prodigal and
# hmmsearch are there too.
#
# This image needs NO ref:: requirement: /usr/local/cct_data carries 705 HMM
# profiles plus repeats.fa, type_dict.tab and xgb_repeats.model, checked inside
# build _2 specifically since _2 postdates the probe session.
#
# But the transform MUST pass --db. $CCTYPER_DB is set by a conda activate.d hook
# that only a login shell sources, and the container exec is not one, so the
# variable is unset at run time and cctyper cannot find its own database. Probing
# with `bash -lc` reports it set and is the wrong test.
container: docker://quay.io/biocontainers/cctyper:1.8.0--pyhdfd78af_2
conda: cctyper
