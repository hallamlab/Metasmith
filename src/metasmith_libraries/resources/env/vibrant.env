# 1.2.1, verified 2026-09-09, digest
# sha256:79a3b6eb49d7ded054d8d65e2a7d28c810b2edf6f742437cb697c9484367b6d4.
# VIBRANT_run.py is on PATH and executes; it is python 3.7 with an old sklearn,
# so it emits an np.float DeprecationWarning on import. That is noise, not a fault.
# 1.2.1 is both the paper's version and the newest that exists -- the 1.0.1 tags
# dated later are rebuilds of an OLDER release, so there is nothing to bump to.
#
# The reference is half here already. $VIBRANT_DATA_PATH points at
# /usr/local/share/vibrant-1.2.1/db, whose files/ subtree is complete and is the
# -m argument. Only databases/, the -d argument, needs the HMM download. So the
# ref type covers -d only; -m is read out of the image.
container: docker://quay.io/biocontainers/vibrant:1.2.1--hdfd78af_4
conda: vibrant
