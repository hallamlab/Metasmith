# 3.1.4, verified 2026-09-09, digest
# sha256:b8aee8c689c9e932ea941dbb27f06bb532d841481b673e0e33ead4a4174d69ef.
# `vcontact3` is on PATH and prints its {version, prepare_databases, run}
# subcommands -- note it has no --version flag, only a `version` subcommand.
# 3.1.4 is the paper's version; 3.1.6 exists.
#
# The database fetch must run in THIS image. From 3.0.5 `prepare_databases` only
# offers releases the installed version can read, so fetching from anywhere else
# can stage one 3.1.4 will refuse.
container: docker://quay.io/biocontainers/vcontact3:3.1.4--pyhdfd78af_1
conda: vcontact3
