# 1.2.0 is a HARD floor, not a preference: the GTDB r232 database (gtdb232) uses
# a database format 1.1.0 cannot read at all. Pairing 1.1.0 with an r232 build
# fails at load, not at classification. The Arbutus reference volume's MANIFEST
# records the same floor as MIN_METABULI and its runner enforces it up front.
container: docker://quay.io/biocontainers/metabuli:1.2.0--pl5321h0bb26bb_0
conda: metabuli
