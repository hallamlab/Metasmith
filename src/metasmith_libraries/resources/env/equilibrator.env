# The direction lane's thermodynamic member.
#
# A SEPARATE image from rdkit.env, and not by choice: equilibrator-cache 0.7.1 requires
# numpy>=2 while torch 2.2.1 (which the AAM stack's two neural mappers need) is compiled
# against the numpy 1.x C API. Forcing them together does not fail loudly -- torch emits
# "Failed to initialize NumPy: _ARRAY_API not found" as a warning and runs on with its
# tensor<->numpy bridge broken.
#
# The image carries NO dGbyG (torch 2.8 + torch-geometric, a third mutually exclusive
# pin) and NO compound cache -- compounds.sqlite is 1.3 GB and arrives as
# `fabfos_data::equilibrator`, presented through XDG_CACHE_HOME, which is the only lever
# `equilibrator_cache` reads.
container: docker://quay.io/hallamlab/ecspr_bake:direction
conda: build-refs-equilibrator
