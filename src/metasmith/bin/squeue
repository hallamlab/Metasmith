#!/opt/conda/envs/metasmith_env/bin/python
# this bounces "squeue" commands from inside a container

import sys
import time
import random
from pathlib import Path
from metasmith.coms.via_file_watcher import RemoteShell
from metasmith.agents import AgentPaths
from metasmith.logging import Log

Log.SetStdout(on=False)
Log.AddLogFile(Path("./squeue.log"), rotate=3)
def err(msg: str):
    print(msg, file=sys.stderr)
    Log.Error(msg)
def out(msg: str):
    Log.Info(msg)
    print(msg) # pass through sbatch output

def call():
    printed = False
    def notify(x, f):
        nonlocal printed
        printed = True
        f(x)
    with RemoteShell(AgentPaths.to_local_relay_coms()) as shell:
        shell.RegisterOnOut(lambda x: notify(x, out))
        shell.RegisterOnErr(lambda x: notify(x, err))
        args = [f'"{x}"' if len(x)>0 and x[0]!="-" else x for x in sys.argv[1:]]
        Log.Info("args:")
        Log.Info(' '.join(args))
        shell.Exec(f"squeue {' '.join(args)}")
    if not printed:
        out("0              CD") # maybe nextflow needs at least 1 line, so we give dummy report
    Log.Info('//')

for retry in range(5):
    try:
        call()
        break
    except (TimeoutError, ConnectionError, FileNotFoundError):
        dt = random.random()*(2**retry)+0.1
        time.sleep(dt)
